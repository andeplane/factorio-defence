{
  "name": "factorio-defence",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:flows": "vite --mode flows",
    "build": "tsc --noEmit && vite build",
    "build:flows": "tsc --noEmit && vite build --mode flows",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "extract-sprites": "bash tools/factorio-extract/extract.sh",
    "balance": "vite-node tools/balance.ts --",
    "capacity": "vite-node tools/capacity.ts",
    "trace": "vite-node tools/trace.ts --",
    "balance:all": "bash tools/balance-all.sh",
    "tune": "vite-node tools/tune.ts --",
    "tune:all": "bash tools/tune-all.sh",
    "compare": "vite-node tools/compare.ts --",
    "deploy:pages": "bash tools/deploy-pages.sh",
    "upload:cdf": "vite-node tools/upload-assets-cdf.ts --",
    "deploy:flows": "bash tools/deploy-flows.sh"
  },
  "dependencies": {
    "@cognite/app-sdk": "^0.9.0",
    "pixi.js": "^8.22.0"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "vite": "^7.3.7",
    "vitest": "^3.2.7"
  }
}
